[Unit]
Description=FreeQNAP first-login root password setup
After=local-fs.target
Before=ssh.service serial-getty@ttyS0.service
ConditionPathExists=/etc/freeqnap/require-root-password
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/freeqnap/credentials.py
RemainAfterExit=yes
Restart=on-failure
RestartSec=2
TimeoutStartSec=0
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
TTYReset=yes
TTYVHangup=yes
UMask=0077

[Install]
WantedBy=multi-user.target
