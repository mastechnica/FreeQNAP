[Unit]
Description=FreeQNAP OpenVPN or WireGuard client and server
After=network.target freeqnap-vpn-firewall.service systemd-resolved.service
Requires=freeqnap-vpn-firewall.service

[Service]
Type=simple
WorkingDirectory=/opt/freeqnap/current
ExecStart=/usr/bin/python3 -B -m freeqnap.nas.vpn_runtime
Restart=always
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/freeqnap-system /run /proc/sys/net /dev/net
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
