[Unit]
Description=FreeQNAP read-only hardware inventory
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=freeqnap
WorkingDirectory=/opt/freeqnap/current
ExecStart=/usr/bin/python3 -B -m freeqnap.collector
TimeoutStartSec=95
UMask=0027
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/freeqnap
NoNewPrivileges=yes
