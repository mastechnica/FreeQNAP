[Unit]
Description=FreeQNAP LAN-only HTTPS reverse proxy
Wants=network-online.target
Requires=freeqnap-console.service
After=network-online.target freeqnap-console.service

[Service]
Type=simple
User=freeqnap-https
Group=freeqnap-https
LoadCredential=nginx.conf:/etc/freeqnap-https/nginx.conf
LoadCredential=server.crt:/etc/freeqnap-https/server.crt
LoadCredential=server.key:/etc/freeqnap-https/server.key
RuntimeDirectory=freeqnap-https
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/install -d -m 700 /run/freeqnap-https/body /run/freeqnap-https/proxy
ExecStartPre=/usr/sbin/nginx -t -c %d/nginx.conf
ExecStart=/usr/sbin/nginx -c %d/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/run/freeqnap-https
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
KillSignal=SIGQUIT
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
