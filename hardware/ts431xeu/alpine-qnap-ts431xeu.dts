// SPDX-License-Identifier: GPL-2.0-only
/* AL314/QZ11 RAM-first bring-up. Addresses checked against this unit's QTS DTB.
 * Flash excluded; only documented disk LED outputs. MCU policy is in userspace.
 */
/dts-v1/;
#include "alpine.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
/ {
 model = "QNAP TS-431XeU (EyeQ Debian bring-up)";
 compatible = "qnap,ts-431xeu", "al,alpine";
 aliases { serial0 = &uart0; serial1 = &uart1; };
 chosen { stdout-path = "serial0:115200n8";
  bootargs = "console=ttyS0,115200 earlycon=uart8250,mmio32,0xfd883000 rdinit=/init panic=0";
 };
 memory { reg = <0 0 0 0x80000000>; };
 /* Board model GPIO:I20:P: hexadecimal gpiolib line0x20, inverted, bank4 pin0.
  * Candidate input is observed before assigning reboot policy; KEY_PROG1 keeps
  * logind from acting on this diagnostic event during the bench acceptance.
  */
 eyeq-buttons {
  compatible = "gpio-keys";
  reset {
   label = "EyeQ reset button";
   gpios = <&gpio4 0 GPIO_ACTIVE_LOW>;
   linux,code = <KEY_PROG1>;
   debounce-interval = <50>;
  };
 };
 /* Exact stock AHCI code consumes sata_sw_leds dev9 GPIO entries directly,
  * without a standalone DT driver binding. It drives raw output values.
  * MCU @O61 is also required; initial GPIO-only tests omitted that prerequisite.
  * Occupied bays1/2 physically proved. Their physical LEDs are active-low;
  * class semantics must invert the raw GPIO, unlike the vendor raw callback.
  */
 leds {
  compatible = "gpio-leds";
  disk1 { label = "eyeq:green:disk1"; gpios = <&gpio3 0 GPIO_ACTIVE_LOW>; default-state = "off"; };
  disk2 { label = "eyeq:green:disk2"; gpios = <&gpio3 1 GPIO_ACTIVE_LOW>; default-state = "off"; };
  disk3 { label = "eyeq:green:disk3"; gpios = <&gpio4 4 GPIO_ACTIVE_LOW>; default-state = "off"; };
  disk4 { label = "eyeq:green:disk4"; gpios = <&gpio4 5 GPIO_ACTIVE_LOW>; default-state = "off"; };
 };
 soc {
  /* Firmware already trains PCIe0. AL314 uses the legacy +0x2000 DBI layout.
   * Register locations/IRQ/ranges are from this board's stock DT; known PCIe
   * control reads verified root-port ID/class and 5 GT/s x1 link before enabling.
   */
  pcie@fb600000 {
   compatible = "qnap,ts431xeu-pcie";
   reg = <0 0xfb600000 0 0x200000>,
         <0 0xfd800000 0 0x2000>,
         <0 0xfd802000 0 0x1000>;
   reg-names = "config", "controller", "dbi";
   device_type = "pci";
   #address-cells = <3>; #size-cells = <2>; #interrupt-cells = <1>;
   bus-range = <0 1>;
   linux,pci-domain = <1>;
   interrupt-map-mask = <0 0 0 7>;
   interrupt-map = <0 0 0 1 &gic GIC_SPI 45 IRQ_TYPE_LEVEL_HIGH>;
   msi-parent = <&msix>;
   ranges = <0x02000000 0 0xe0010000 0 0xe0010000 0 0x07ff0000>;
   dma-coherent;
  };
  serdes@fd8c0000 { compatible = "annapurna-labs,al-serdes"; reg = <0 0xfd8c0000 0 0x1000>; };
  pbs@fd8a8000 { compatible = "al,alpine-pbs", "annapurna-labs,al-pbs"; reg = <0 0xfd8a8000 0 0x1000>; };
  sbclk: sbclk { compatible = "fixed-clock"; #clock-cells = <0>; clock-frequency = <375000000>; };
  i2c0: i2c@fd880000 {
   compatible = "snps,designware-i2c"; reg = <0 0xfd880000 0 0x1000>;
   #address-cells = <1>; #size-cells = <0>;
   interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>; clocks = <&sbclk>;
   clock-frequency = <400000>;
   rtc@32 { compatible = "epson,rx8010"; reg = <0x32>; };
  };
  watchdog@fd88c000 {
   compatible = "arm,sp805", "arm,primecell"; reg = <0 0xfd88c000 0 0x1000>;
   interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>; clocks = <&sbclk>;
   clock-names = "apb_pclk"; timeout-sec = <10>;
  };
  gpio0: gpio@fd887000 {
   compatible = "arm,pl061", "arm,primecell"; reg = <0 0xfd887000 0 0x1000>;
   interrupts = <GIC_SPI 2 IRQ_TYPE_LEVEL_HIGH>; clocks = <&sbclk>;
   clock-names = "apb_pclk"; gpio-controller; #gpio-cells = <2>;
  };
  gpio1: gpio@fd888000 {
   compatible = "arm,pl061", "arm,primecell"; reg = <0 0xfd888000 0 0x1000>;
   interrupts = <GIC_SPI 3 IRQ_TYPE_LEVEL_HIGH>; clocks = <&sbclk>;
   clock-names = "apb_pclk"; gpio-controller; #gpio-cells = <2>;
  };
  gpio2: gpio@fd889000 {
   compatible = "arm,pl061", "arm,primecell"; reg = <0 0xfd889000 0 0x1000>;
   interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>; clocks = <&sbclk>;
   clock-names = "apb_pclk"; gpio-controller; #gpio-cells = <2>;
  };
  gpio3: gpio@fd88a000 {
   compatible = "arm,pl061", "arm,primecell"; reg = <0 0xfd88a000 0 0x1000>;
   interrupts = <GIC_SPI 5 IRQ_TYPE_LEVEL_HIGH>; clocks = <&sbclk>;
   clock-names = "apb_pclk"; gpio-controller; #gpio-cells = <2>;
  };
  gpio4: gpio@fd88b000 {
   compatible = "arm,pl061", "arm,primecell"; reg = <0 0xfd88b000 0 0x1000>;
   interrupts = <GIC_SPI 6 IRQ_TYPE_LEVEL_HIGH>; clocks = <&sbclk>;
   clock-names = "apb_pclk"; gpio-controller; #gpio-cells = <2>;
  };
  gpio5: gpio@fd897000 {
   compatible = "arm,pl061", "arm,primecell"; reg = <0 0xfd897000 0 0x1000>;
   interrupts = <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>; clocks = <&sbclk>;
   clock-names = "apb_pclk"; gpio-controller; #gpio-cells = <2>;
  };
  thermal: thermal@fd860a00 {
   compatible = "al,alpine-thermal"; reg = <0 0xfd860a00 0 0x100>; #thermal-sensor-cells = <0>;
  };
 };
 thermal-zones {
  cpu-thermal {
   polling-delay-passive = <250>; polling-delay = <1000>; thermal-sensors = <&thermal>;
   trips {
    /* Conservative bench cutoff, not a claimed silicon temperature rating. */
    bench-critical { temperature = <80000>; hysteresis = <2000>; type = "critical"; };
   };
  };
 };
};
/* Required for Alpine's MSI cascade discovery on the 6.12 baseline. */
&msix { interrupt-controller; #interrupt-cells = <1>; #address-cells = <0>; };
