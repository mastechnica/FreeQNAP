# Optional NAS/test feature fragment, merged with the board configuration.
# BLK_DEV is a Kconfig menu; enabling it alone adds no kernel code.
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=m
CONFIG_BLK_DEV_LOOP_MIN_COUNT=0
# Native LUKS primitives are already enabled in the accepted generic kernel.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y

# Native VPN candidate: these require a complete kernel rebuild, not forced modules.
CONFIG_TUN=y
CONFIG_WIREGUARD=y

# Private-LAN ICMP rate limiting; matching optional module also supported.
CONFIG_NFT_LIMIT=m

# Optional read-only foreign encrypted USB readers; tested as matching modules.
CONFIG_FUSE_FS=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
CONFIG_DM_ZERO=m
